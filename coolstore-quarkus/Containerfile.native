# =============================================================================
# CoolStore Quarkus — Native Containerfile (multi-stage, Red Hat UBI9)
#
# Stage 1 (build):   registry.access.redhat.com/ubi9/openjdk-17:latest (GraalVM via Quarkus)
# Stage 2 (runtime): registry.access.redhat.com/ubi9/ubi-micro:latest  (minimal footprint)
#
# NOTE: Native builds require a GraalVM-capable build environment.
#       To use Quarkus' container-build feature (avoids installing GraalVM locally):
#         mvn package -Pnative -Dquarkus.native.container-build=true
#
# Security hardening:
#   - Non-root UID 1001
#   - Minimal ubi-micro runtime (no package manager, no shell in final image)
#   - Audit log directory pre-created and owned by UID 1001
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1 — Native build
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/openjdk-17:latest AS build

WORKDIR /build

COPY pom.xml .
RUN mvn dependency:go-offline -q 2>/dev/null || true

COPY src ./src
# -Dquarkus.native.container-build=false assumes GraalVM is present in the
# build image; adjust to =true if the host does not have GraalVM installed.
RUN mvn package -Pnative -DskipTests -q

# ---------------------------------------------------------------------------
# Stage 2 — Minimal runtime (ubi-micro — no shell, no package manager)
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-micro:latest

WORKDIR /deployments

# Copy native binary and pre-create audit log directory in a single layer
COPY --from=build /build/target/*-runner /deployments/application

# Set ownership; ubi-micro has no useradd, so we rely on --chown at COPY time
# and use UID 1001 (matches OpenShift restricted SCC convention).
RUN mkdir -p /deployments/device-inventory-audit-logs /tmp && \
    chmod 755 /deployments/application && \
    chmod 755 /deployments/device-inventory-audit-logs && \
    chmod 1777 /tmp

EXPOSE 8080 8443

USER 1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/deployments/application", "health-check"] || exit 1

ENTRYPOINT ["/deployments/application", "-Dquarkus.http.host=0.0.0.0"]
