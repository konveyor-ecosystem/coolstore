# Multi-stage build: Stage 1 - Build
FROM registry.access.redhat.com/ubi9/openjdk-17:latest AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn package -DskipTests -q

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:latest

# Install curl for health checks
USER root
RUN microdnf install -y curl && microdnf clean all

WORKDIR /deployments

# Quarkus fast-jar layout
COPY --chown=185 --from=build /build/target/quarkus-app/lib/ ./lib/
COPY --chown=185 --from=build /build/target/quarkus-app/*.jar ./
COPY --chown=185 --from=build /build/target/quarkus-app/app/ ./app/
COPY --chown=185 --from=build /build/target/quarkus-app/quarkus/ ./quarkus/

# Create audit log directory
RUN mkdir -p /deployments/device-inventory-audit-logs && \
    chown -R 185:185 /deployments/device-inventory-audit-logs

EXPOSE 8080 8443

USER 185

ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
